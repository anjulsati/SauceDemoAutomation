<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Critical-path smoke suite. Run with:
     mvn test -Dsurefire.suiteXmlFiles=src/test/resources/testng-smoke.xml -->
<suite name="SauceDemo Smoke Suite" verbose="1">

    <test name="SauceDemo Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.saucedemo.tests.LoginTests"/>
            <class name="com.saucedemo.tests.InventoryTests"/>
            <class name="com.saucedemo.tests.CartTests"/>
            <class name="com.saucedemo.tests.CheckoutTests"/>
            <class name="com.saucedemo.tests.NavigationTests"/>
        </classes>
    </test>

</suite>
